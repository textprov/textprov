+#!/usr/bin/env python3
+"""Replace an existing explicit P+ sawtooth without migrating its registry.
+
+Usage: refresh-provenance-dots.py OLD.ttf NEW.ttf
+Updates only AI inspection geometry. It never installs the output. Existing
+cmap/UVS, layout tables, names, advances and unrelated outlines are retained.
+Full gradient mist and 60% dot alpha belong to the application stylesheet.
+"""
+import argparse
+import math
+from pathlib import Path
+from fontTools.pens.ttGlyphPen import TTGlyphPen
+from fontTools.ttLib import TTFont
+from fontTools.ttLib.tables._g_l_y_f import GlyphComponent
+
+
+def dotted_strip(advance, em, low, height):
+    count = max(1, int(round(advance / (em / 6))))
+    pitch = advance / count
+    radius = min(em / 32, height / 2, pitch / 4)
+    center_y = low + radius
+    pen = TTGlyphPen(None)
+    for index in range(count):
+        center_x = (index + .5) * pitch
+        pen.moveTo((center_x, center_y + radius))
+        for corner in range(1, 8):
+            angle = corner * math.pi / 4
+            pen.lineTo((center_x + radius * math.sin(angle), center_y + radius * math.cos(angle)))
+        pen.closePath()
+    return pen.glyph()
+
+
+def refresh(source, output):
+    if Path(source).resolve() == Path(output).resolve():
+        raise ValueError('write a separate output; keep the old font for comparison')
+    font = TTFont(source, recalcTimestamp=False, recalcBBoxes=False)
+    if 'glyf' not in font or 'fvar' in font or 'COLR' in font:
+        raise ValueError('expected a static monochrome TrueType P+ font')
+    table = next((table for table in font['cmap'].tables if table.format == 14), None)
+    if table is None or not table.uvsDict.get(0xE0101):
+        raise ValueError('font has no explicit AI selector mapping')
+    glyf, metrics = font['glyf'], font['hmtx']
+    old_mark = 'provenance.mark.ai'
+    if old_mark not in glyf or glyf[old_mark].isComposite() or glyf[old_mark].numberOfContours != 1:
+        raise ValueError('expected the legacy explicit AI sawtooth contour')
+    old = glyf[old_mark]
+    coordinates, ends, _ = old.getCoordinates(glyf)
+    if len(coordinates) != 6 or len(ends) != 1:
+        raise ValueError('AI mark is not the legacy six-point sawtooth; do not replace another style')
+    low, height = old.yMin, old.yMax - old.yMin
+    order = list(font.getGlyphOrder())
+    strips = {}
+    updated = set()
+    for _, variant in table.uvsDict[0xE0101]:
+        if variant in updated:
+            continue
+        glyph = glyf[variant]
+        if not glyph.isComposite():
+            raise ValueError(f'{variant}: expected a composite AI variant')
+        marks = [component for component in glyph.components if component.glyphName == old_mark]
+        if len(marks) != 1:
+            raise ValueError(f'{variant}: expected exactly one legacy AI mark reference')
+        advance = metrics[variant][0]
+        if advance <= 0:
+            raise ValueError(f'{variant}: expected a positive advance')
+        if advance not in strips:
+            name = f'provenance.mark.ai.{advance}'
+            if name in glyf:
+                raise ValueError(f'new strip name is already occupied: {name}')
+            strip = dotted_strip(advance, font['head'].unitsPerEm, low, height)
+            glyf[name] = strip
+            strip.recalcBounds(glyf)
+            metrics[name] = (advance, 0)
+            order.append(name)
+            strips[advance] = name
+        replacement = GlyphComponent()
+        replacement.glyphName = strips[advance]
+        replacement.x = replacement.y = 0
+        replacement.flags = 0
+        glyph.components = [replacement if component is marks[0] else component for component in glyph.components]
+        glyph.recalcBounds(glyf)
+        updated.add(variant)
+    # Leave the old glyph ID stable for layout tables, but remove its defunct
+    # contour. No unused sawtooth survives in the updated font.
+    glyf[old_mark] = TTGlyphPen(None).glyph()
+    font.setGlyphOrder(order)
+    font.save(output)
+    print(f'{Path(output).name}: refreshed {len(updated)} AI variants; {len(strips)} dotted strip(s); registry retained')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('source')
+    parser.add_argument('output')
+    args = parser.parse_args()
+    refresh(args.source, args.output)
+
+
+if __name__ == '__main__':
+    main()
