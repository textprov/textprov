+#!/usr/bin/env python3
+"""Check explicit P+ dotted outlines and unchanged mappings/metrics.
+
+Run after test-provenance.py: test-provenance-dots.py FONT [--reference OLD_FONT].
+The font fallback is monochrome; opacity and gradient mist belong to the app.
+"""
+import argparse
+from pathlib import Path
+from fontTools.ttLib import TTFont
+
+
+def check(path, reference=None):
+    font = TTFont(path)
+    glyf = font['glyf']
+    marks = [name for name in font.getGlyphOrder() if name.startswith('provenance.mark.ai.')]
+    assert marks, 'no explicit dotted strips found'
+    dots = 0
+    for name in marks:
+        glyph = glyf[name]
+        assert glyph.numberOfContours > 0, f'{name}: no dots'
+        coords, ends, _ = glyph.getCoordinates(glyf)
+        previous = -1
+        bounds = []
+        centers = []
+        for end in ends:
+            contour = list(coords[previous + 1:end + 1])
+            assert len(contour) == 8, f'{name}: expected an octagonal dot, got {len(contour)} points'
+            xs, ys = zip(*contour)
+            left, right, bottom, top = min(xs), max(xs), min(ys), max(ys)
+            assert right > left and top > bottom, f'{name}: empty dot'
+            assert abs((right-left)-(top-bottom)) <= 2, f'{name}: stretched dot'
+            bounds.append((left,right))
+            centers.append((bottom+top)/2)
+            previous = end
+            dots += 1
+        ordered = sorted(bounds)
+        assert all(left > previous_right for (_,previous_right),(left,_) in zip(ordered,ordered[1:])), f'{name}: joined dots'
+        assert max(centers)-min(centers) <= 1, f'{name}: dot baseline varies'
+        assert glyph.xMin >= 0 and glyph.xMax <= font['hmtx'][name][0], f'{name}: dot exceeds advance'
+
+    uvs = next(table for table in font['cmap'].tables if table.format == 14).uvsDict
+    ai_bases = 0
+    for base, variant in uvs[0xE0101]:
+        assert variant is not None, f'U+{base:04X}: missing explicit AI variant'
+        components = glyf[variant].components
+        assert len(components) == 2, f'{variant}: expected base and dotted strip'
+        strips = [component.getComponentInfo() for component in components if component.glyphName in marks]
+        assert len(strips) == 1, f'{variant}: still uses an obsolete mark'
+        strip, transform = strips[0]
+        assert transform == (1, 0, 0, 1, 0, 0), f'{variant}: dotted strip is stretched'
+        assert font['hmtx'][variant][0] == font['hmtx'][font.getBestCmap()[base]][0], f'{variant}: advance changed'
+        ai_bases += 1
+
+    if reference:
+        old = TTFont(reference)
+        assert font.getBestCmap() == old.getBestCmap(), 'encoded glyph mappings changed'
+        old_uvs = next(table for table in old['cmap'].tables if table.format == 14).uvsDict
+        assert {selector:dict(pairs) for selector,pairs in uvs.items()} == {selector:dict(pairs) for selector,pairs in old_uvs.items()}, 'variation-selector mappings changed'
+        for name in ('hhea', 'OS/2'):
+            fields = ('ascent', 'descent', 'lineGap') if name == 'hhea' else ('sTypoAscender', 'sTypoDescender', 'sTypoLineGap', 'usWinAscent', 'usWinDescent')
+            for field in fields:
+                assert getattr(font[name], field) == getattr(old[name], field), f'{name}.{field}: line metric changed'
+        for name in set(font['hmtx'].metrics) & set(old['hmtx'].metrics):
+            if name.startswith('provenance.mark.ai'):
+                continue
+            assert font['hmtx'][name] == old['hmtx'][name], f'{name}: horizontal metric changed'
+        ai_variants = {variant for _,variant in uvs[0xE0101]}
+        for name in old.getGlyphOrder():
+            if name in ai_variants or name.startswith('provenance.mark.ai'):
+                continue
+            assert glyf[name].getCoordinates(glyf) == old['glyf'][name].getCoordinates(old['glyf']), f'{name}: non-AI outline changed'
+        for tag in ('name', 'GSUB', 'GDEF', 'GPOS', 'kern'):
+            assert (tag in font) == (tag in old), f'{tag}: table presence changed'
+            if tag in old:
+                assert font.getTableData(tag) == old.getTableData(tag), f'{tag}: table changed'
+        assert glyf['provenance.mark.ai'].numberOfContours == 0, 'unused defunct contour survives'
+    scope = 'original mappings, names, layout, non-AI outlines and metrics preserved' if reference else 'AI advances match base glyphs'
+    print(f'PASS {Path(path).name}: {len(marks)} dotted strip(s), {dots} separate round dots, {ai_bases} AI bases; {scope}')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('font')
+    parser.add_argument('--reference')
+    args = parser.parse_args()
+    check(args.font, args.reference)
+
+
+if __name__ == '__main__':
+    main()
